# ============================================================
# CopyTrader — YZTA Bootcamp 2026 (Takım 36)
# Tüm değerler isteğe bağlıdır; bot default'larla da çalışır.
# Kopyalayıp .env olarak kaydedin (veya hiç oluşturmayın).
# ============================================================

# --- Sunucu ---
HOST=0.0.0.0
PORT=8000

# --- Piyasa verisi (Binance PUBLIC API — API key GEREKMEZ) ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
SCAN_INTERVAL_SEC=15          # strateji tarama aralığı
PRICE_REFRESH_SEC=3           # fiyat güncelleme aralığı (dashboard)

# --- Strateji ---
# funding | technical | both  (dashboard'dan da değiştirilebilir)
ACTIVE_STRATEGY=both
# Funding rate eşikleri (0.01 = %0.01)
FUNDING_RATE_THRESHOLD=0.01
# Technical: EMA kısa/uzun + RSI + MACD parametreleri
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# --- Risk yönetimi ---
MAX_OPEN_POSITIONS=3
MAX_POSITION_SIZE_USD=25
MAX_PORTFOLIO_RISK_PCT=50
STOP_LOSS_PCT=5.0
TAKE_PROFIT_PCT=8.0
MAX_DAILY_LOSS_USD=20

# --- Paper / Live ---
# paper: gerçek para yok, simülasyon (API key GEREKMEZ)
# live:  gerçek Binance emirleri (BINANCE_API_KEY + SECRET gerekir)
TRADING_MODE=paper
# Live mod için (opsiyonel):
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- AI (OPSİYONEL — boş bırakılırsa kural bazlı sinyal üretilir) ---
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
