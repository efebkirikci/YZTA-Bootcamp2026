# CopyTrader — ornek ayarlar (kopyala: cp .env.example .env)
HOST=0.0.0.0
PORT=8000
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
PRICE_REFRESH_SEC=3
SCAN_INTERVAL_SEC=15

# Paper / Live
TRADING_MODE=paper

# AI (OPSIYONEL — bos birakilirsa kural bazli sinyal uretimi)
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
